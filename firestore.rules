rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /birthdays/{birthdayId} {
      allow read, write: if true;
    }
    match /form_submissions/{submissionId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
